{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(node:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(python3:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(jq:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(pkill -f gym-fixture:*)",
      "Bash(bash team/*)",
      "Bash(bash .claude/hooks/teamos-browser-loop.sh:*)",
      "Bash(.claude/hooks/teamos-browser-loop.sh:*)"
    ],
    "deny": [
      "WebSearch",
      "WebFetch",
      "Bash(git push:*)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/teamos-test-output-filter.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/teamos-loop-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
