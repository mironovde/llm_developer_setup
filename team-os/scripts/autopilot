#!/usr/bin/env bash
# Team OS autopilot — external ralph-style loop over headless claude -p iterations.
# Fresh context per iteration; state lives in team/ files; survives crashes and Max-window limits.
# No permission bypass: acceptEdits + allowlists; irreversible ops hook-denied via TEAMOS_AUTOPILOT=1.
#
# Usage: autopilot [project_dir] [--max-iterations N] [--iteration-timeout SECS] [--model M] [--prompt-file F] [--selftest]
# Stop conditions: $HALT_FILE (agent-written blocker) · $RUN_DIR/done (all work finished).
# Both are resolved from the project's state layer — team/ where it exists, else .artifacts/.
#                  · iteration cap · circuit breaker (3 iterations without repo changes)
#                  · repeated permission denials (2 consecutive iterations)
# Tip for overnight runs on macOS: caffeinate -i autopilot <dir>
set -euo pipefail

LIB="$(cd "$(dirname "$0")" && pwd)/teamos-lib.sh"
# shellcheck source=teamos-lib.sh
. "$LIB"

DIR="."
MAX_ITER=20
ITER_TIMEOUT=2400
MODEL=""
PROMPT_FILE=""
SELFTEST=0
while [ $# -gt 0 ]; do
  case "$1" in
    --max-iterations) MAX_ITER="${2:?}"; shift 2 ;;
    --iteration-timeout) ITER_TIMEOUT="${2:?}"; shift 2 ;;
    --model) MODEL="${2:?}"; shift 2 ;;
    --prompt-file) PROMPT_FILE="${2:?}"; shift 2 ;;
    --selftest) SELFTEST=1; shift ;;
    *) DIR="$1"; shift ;;
  esac
done

if [ "$SELFTEST" -eq 1 ]; then
  echo "== autopilot selftest =="
  fails=0
  e1=$(parse_reset_epoch "You've hit your session limit · resets 3:45pm")
  e2=$(parse_reset_epoch "You're out of extra usage · resets 9pm")
  e3=$(parse_reset_epoch "resets 21:15 tomorrow maybe")
  e4=$(parse_reset_epoch "no reset info at all")
  now=$(date +%s)
  for name in e1 e2 e3 e4; do
    v=$(eval echo \$$name)
    if ! [ "$v" -gt "$now" ] 2>/dev/null; then echo "FAIL: $name=$v not in future"; fails=$((fails+1)); else echo "OK: $name=+$(( (v-now)/60 ))min"; fi
  done
  T=$(mktemp)
  printf '{"type":"assistant","message":"working"}\n{"type":"rate_limit_event","rate_limit_info":{"status":"rejected","resetsAt":9999999999,"rateLimitType":"five_hour"}}\n' > "$T"
  detect_limit "$T" >/dev/null && echo "OK: structural limit detected" || { echo "FAIL: structural limit missed"; fails=$((fails+1)); }
  RE="$(reset_epoch_from_transcript "$T")"
  [ "$RE" = "9999999999" ] && echo "OK: resetsAt extracted" || { echo "FAIL: resetsAt=$RE"; fails=$((fails+1)); }
  printf '{"type":"rate_limit_event","rate_limit_info":{"status":"allowed","resetsAt":1785540600,"rateLimitType":"five_hour","overageStatus":"rejected"}}\n{"type":"result","is_error":false}\n' > "$T"
  detect_limit "$T" >/dev/null && { echo "FAIL: false positive on informational rate_limit_event (real-world regression case)"; fails=$((fails+1)); } || echo "OK: no false positive on status=allowed event"
  printf '{"type":"assistant"}\n{"type":"result","is_error":true,"result":"You have hit your session limit · resets 3:45pm"}\n' > "$T"
  detect_limit "$T" >/dev/null && echo "OK: text limit detected" || { echo "FAIL: text limit missed"; fails=$((fails+1)); }
  printf '{"type":"user","tool_result":"file says usage limit reached inside code"}\n{"type":"result","is_error":false}\n' > "$T"
  detect_limit "$T" >/dev/null && { echo "FAIL: false positive on tool_result echo"; fails=$((fails+1)); } || echo "OK: no false positive on echoed content"
  printf '{"type":"result","subtype":"success","is_error":false,"num_turns":5,"duration_ms":9000,"session_id":"s1","total_cost_usd":0.5,"usage":{"input_tokens":100,"output_tokens":2000,"cache_read_input_tokens":30000,"cache_creation_input_tokens":8000},"modelUsage":{"claude-opus-5":{}}}\n' > "$T"
  R="$(extract_result_json "$T")"
  M=$(mktemp)
  append_metrics "$M" "$R" "selftest" "T1" "autopilot" ""
  jq -e '.out_tok == 2000 and .outcome == "ok" and .model == "claude-opus-5"' "$M" >/dev/null && echo "OK: metrics row" || { echo "FAIL: metrics row"; cat "$M"; fails=$((fails+1)); }
  b=$(budget_used "$R")
  [ "$b" = "10100" ] && echo "OK: budget_used=$b" || { echo "FAIL: budget_used=$b (want 10100)"; fails=$((fails+1)); }
  rm -f "$T" "$M"
  echo "selftest: $fails failures"
  exit "$fails"
fi

cd "$DIR"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "autopilot: $(pwd) is not a git repository" >&2; exit 1; }

# State layer: team/ where a project still has one, otherwise the project's own planning dir,
# otherwise NOTES.md. Before 2026-08-10 this hard-required team/ and refused to start anywhere
# else — which after the config was cut to a minimal core meant it refused in most projects.
if [ -d team ]; then
  STATE_LAYER="team/"; STATE_ENTRY="team/SPRINT.md"; RUN_DIR="team/.autopilot"; HALT_FILE="team/HALT"
elif [ -d .planning ]; then
  STATE_LAYER=".planning/"; STATE_ENTRY=".planning/STATE.md"; RUN_DIR=".artifacts/.autopilot"; HALT_FILE=".artifacts/HALT"
else
  STATE_LAYER="NOTES.md"; STATE_ENTRY="NOTES.md"; RUN_DIR=".artifacts/.autopilot"; HALT_FILE=".artifacts/HALT"
fi
[ -d team ] && METRICS="team/metrics.jsonl" || METRICS=".artifacts/metrics.jsonl"
mkdir -p "$RUN_DIR" "$(dirname "$METRICS")"
LOG="$RUN_DIR/log"
STATE_DIR="$RUN_DIR"
log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$LOG"; }

DEFAULT_PROMPT="Unattended run. Fresh context; everything you need is on disk.
1. Read $STATE_ENTRY and the task list. Do not re-read the whole project.
2. Pick ONE unit of work, highest priority first: security fixes, then unblocked in-flight work,
   then the top of the backlog. One coherent unit, not three half-units.
3. Do it under the working agreement: reproduce before fixing, verify with a command you ran and
   read, never weaken a test.
4. Write state to $STATE_LAYER as you go, not at the end — this run can be killed at any moment
   and a successor with none of your context has to continue from what is on disk.
5. Commit the unit. Nobody is here to answer questions, so never ask one: if a decision is
   genuinely the user's (product direction, budget, a security trade-off) or you are blocked,
   write the reason to $HALT_FILE and stop.
6. Irreversible or outward actions — deploy, publish, force-push, payments, deleting data — are
   forbidden here. Queue them in $STATE_ENTRY as awaiting the user and carry on with other work.
7. When everything planned is done, write a five-line summary to $RUN_DIR/done and stop.
End your turn once the unit is complete and its state is written."

PROMPT="$DEFAULT_PROMPT"
[ -n "$PROMPT_FILE" ] && PROMPT="$(cat "$PROMPT_FILE")"

repo_state_hash() {
  { git rev-parse HEAD 2>/dev/null; git status --porcelain 2>/dev/null | sort; } | shasum | cut -d' ' -f1
}

NO_PROGRESS=0
DENIAL_STREAK=0
PREV_HASH="$(repo_state_hash)"
ITER=0
log "autopilot start: max_iter=$MAX_ITER timeout=${ITER_TIMEOUT}s dir=$(pwd)"

while :; do
  ITER=$((ITER + 1))
  if [ "$ITER" -gt "$MAX_ITER" ]; then log "STOP: iteration cap ($MAX_ITER) reached"; exit 0; fi
  if [ -f "$HALT_FILE" ]; then log "STOP: $HALT_FILE present: $(head -3 "$HALT_FILE" | tr '\n' ' ')"; exit 0; fi
  if [ -f "$STATE_DIR/done" ]; then log "STOP: done sentinel present"; exit 0; fi

  TRANSCRIPT="$STATE_DIR/iter-$ITER.jsonl"
  log "iteration $ITER starting"
  set +e
  TEAMOS_AUTOPILOT=1 run_with_timeout "$ITER_TIMEOUT" \
    claude -p "$PROMPT" \
      --permission-mode acceptEdits \
      --output-format stream-json --verbose \
      ${MODEL:+--model "$MODEL"} \
      --fallback-model sonnet \
      < /dev/null > "$TRANSCRIPT" 2>"$STATE_DIR/iter-$ITER.err"
  RC=$?
  set -e

  RESULT="$(extract_result_json "$TRANSCRIPT")"

  # Limit handling: not a failure, wait for the window and continue (does not consume progress counters).
  if LIMIT_LINE="$(detect_limit "$TRANSCRIPT")" || { [ -s "$STATE_DIR/iter-$ITER.err" ] && LIMIT_LINE="$(detect_limit "$STATE_DIR/iter-$ITER.err")"; }; then
    RESET_EPOCH="$(reset_epoch_from_transcript "$TRANSCRIPT")"
    if ! [ "${RESET_EPOCH:-0}" -gt "$(date +%s)" ] 2>/dev/null; then
      RESET_EPOCH="$(parse_reset_epoch "$LIMIT_LINE")"
    fi
    WAIT=$(( RESET_EPOCH - $(date +%s) ))
    [ "$WAIT" -lt 60 ] && WAIT=60
    [ "$WAIT" -gt 21600 ] && WAIT=21600
    append_metrics "$METRICS" "$RESULT" "autopilot-iter-$ITER" "" "autopilot" "limit hit"
    log "limit hit; sleeping ${WAIT}s (until $(date -r "$RESET_EPOCH" 2>/dev/null || date -d "@$RESET_EPOCH" 2>/dev/null))"
    sleep "$WAIT"
    ITER=$((ITER - 1))   # retry does not consume the cap
    continue
  fi

  append_metrics "$METRICS" "$RESULT" "autopilot-iter-$ITER" "" "autopilot" "rc=$RC"

  if [ "$RC" -eq 124 ]; then
    if [ "$(repo_state_hash)" != "$PREV_HASH" ]; then
      log "iteration $ITER timed out but produced changes (productive timeout) — continuing"
    else
      log "iteration $ITER timed out with no changes"
    fi
  fi

  # Permission-denial streak → halt (agent is blocked on rights, human needed).
  DENIALS=$(printf '%s' "$RESULT" | jq -r '(.permission_denials // []) | length' 2>/dev/null || echo 0)
  if [ "${DENIALS:-0}" -gt 0 ]; then
    DENIAL_STREAK=$((DENIAL_STREAK + 1))
    log "iteration $ITER had $DENIALS permission denials (streak=$DENIAL_STREAK)"
    if [ "$DENIAL_STREAK" -ge 2 ]; then
      printf 'autopilot halted: repeated permission denials — extend allowlists or run these steps manually.\n%s\n' \
        "$(printf '%s' "$RESULT" | jq -c '.permission_denials' 2>/dev/null)" > "$HALT_FILE"
      log "STOP: permission-denial streak"; exit 0
    fi
  else
    DENIAL_STREAK=0
  fi

  # Circuit breaker: no repo changes across 3 consecutive completed iterations.
  CUR_HASH="$(repo_state_hash)"
  if [ "$CUR_HASH" = "$PREV_HASH" ]; then
    NO_PROGRESS=$((NO_PROGRESS + 1))
    log "no repo changes after iteration $ITER (streak=$NO_PROGRESS)"
    if [ "$NO_PROGRESS" -ge 3 ]; then
      printf 'autopilot halted: 3 iterations without repo changes — likely stuck or work is conversational-only.\n' > "$HALT_FILE"
      log "STOP: circuit breaker (no progress x3)"; exit 0
    fi
  else
    NO_PROGRESS=0
  fi
  PREV_HASH="$CUR_HASH"
done
